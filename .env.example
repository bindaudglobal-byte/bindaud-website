# BIN DAUD environment template
# Copy this file to .env or .env.local and replace the example values.
# Do not commit your real .env files to source control.

# Backend runtime
PORT=5000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-jwt-secret
EMAIL_HOST=smtp.example.com
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/bindaud

# Supabase backend configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: browser-side Supabase config
# Configure these values in js/config.js inside window.BINDAUD_CONFIG.api.
# Example:
# window.BINDAUD_CONFIG.api.supabaseUrl = 'https://your-project-id.supabase.co';
# window.BINDAUD_CONFIG.api.supabaseAnonKey = 'your-anon-key';

# Resend email configuration
RESEND_API_KEY==++==your-resend-api-key
EMAIL_FROM=hello@bindaud.com
ADMIN_EMAIL=hello@bindaud.com
SUPPORT_EMAIL=hello@bindaud.com
CLIENT_URL=http://localhost:3000
BRAND_URL=https://bindaud.com
# Optional SMTP configuration (use Resend SMTP settings if you want SMTP delivery)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_resend_smtp_api_key
SMTP_SECURE=true
